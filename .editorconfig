# Shared C# style and analyzer settings (the build enforces them: see Directory.Build.props).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

[tests/**.cs]
# xUnit test names read as sentences (Method_Does_This): underscores are the convention there.
dotnet_diagnostic.CA1707.severity = none

[*.cs]
# ToolError is the MCP tool error of the protocol, in an application rather than a reusable library.
dotnet_diagnostic.CA1710.severity = none
