<Project>
  <!-- Tests (xUnit v3, run by test.ps1): every build and test output goes to ~\.nexus\build\nexusindesign\test, never
       into OneDrive or AppData. -->
  <PropertyGroup>
    <NexusBuild Condition="'$(NexusBuild)' == ''">$(USERPROFILE)\.nexus\build\nexusindesign\</NexusBuild>
    <BaseOutputPath>$(NexusBuild)test\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(NexusBuild)test\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <!-- Strict build: the recommended .NET analyzers and the code style rules of .editorconfig, every warning an error. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
