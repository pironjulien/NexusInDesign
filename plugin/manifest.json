{
  "manifestVersion": 5,
  "id": "fr.pironjulien.indesign.mcp",
  "name": "InDesign MCP Secure",
  "version": "3.2.2",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "19.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "indesignMcpPanel",
      "label": {
        "default": "InDesign MCP"
      },
      "minimumSize": {
        "width": 260,
        "height": 240
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 360
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 420
      }
    }
  ],
  "requiredPermissions": {
    "clipboard": "read",
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": true
  }
}
