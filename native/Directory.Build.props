<Project>
  <!-- Every build output of the engine goes to ~\.nexus\build\nexusindesign\native: never into OneDrive or AppData. -->
  <PropertyGroup>
    <NexusBuild Condition="'$(NexusBuild)' == ''">$(USERPROFILE)\.nexus\build\nexusindesign\</NexusBuild>
    <BaseOutputPath>$(NexusBuild)native\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(NexusBuild)native\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <!-- Strict build: the recommended .NET analyzers and the code style rules of .editorconfig, every warning an error. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
