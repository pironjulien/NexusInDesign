<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>4.3.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NexusInDesign</AssemblyName>
    <RootNamespace>NexusInDesign</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Compiled ahead of time (Native AOT): one native image that Windows maps, nothing loaded later from its file, so
         an update can rename the engine aside while an AI session still runs it (UpdateWhileRunningTests). InDesign is
         driven through its COM automation server by a source-generated IDispatch (ComWrappers, InDesign/Dispatch.cs),
         JSON through source-generated contexts: no reflection at run time. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Both release architectures in the restore graph, so packages.lock.json covers the release publishes. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- The two packages below are pinned on purpose (see there): their "delete explicit reference" notice is answered. -->
    <SuppressGenerateILCompilerExplicitPackageReferenceWarning>true</SuppressGenerateILCompilerExplicitPackageReferenceWarning>
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
  </PropertyGroup>
  <ItemGroup>
    <!-- The AOT compiler and the trimmer, pinned like any package (packages.lock.json, Dependabot): left implicit, their
         version would follow the .NET SDK of the machine and break the locked restore whenever the CI's SDK moves. -->
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.15" />
    <PackageReference Include="JsonSchema.Net" Version="9.6.0" />
    <!-- GDI+ (Windows) downscales the preview PNGs into the capped thumbnails returned as MCP image content. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.15" />
    <EmbeddedResource Include="tool-contracts.json" LogicalName="tool-contracts.json" />
    <!-- French titles and descriptions, kept in the main assembly (not a satellite) despite the .fr suffix. -->
    <EmbeddedResource Include="tool-contracts.fr.json" LogicalName="tool-contracts.fr.json" WithCulture="false" />
    <!-- UXP and ExtendScript templates run by InDesign through DoScript (never through a panel or a plugin). -->
    <EmbeddedResource Include="uxp\*" LogicalName="uxp/%(Filename)%(Extension)" />
    <!-- Adobe's official DOM sitemap (Apache-2.0), pinned by SHA-256 for search_official_dom. -->
    <EmbeddedResource Include="reference\indesign-dom-paths.xml" LogicalName="indesign-dom-paths.xml" />
    <InternalsVisibleTo Include="NexusInDesign.Tests" />
  </ItemGroup>
</Project>
