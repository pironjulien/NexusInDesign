const { app } = require('indesign');
const { script } = require('uxp');

try {
  let doc = null;
  for (let index = 0; index < app.documents.length; index += 1) {
    const candidate = app.documents.item(index);
    if (candidate.extractLabel('fr.pironjulien.indesign.mcp.live-test') === 'owned') { doc = candidate; break; }
  }
  if (!doc) throw new Error('Document de test introuvable.');
  const frame = doc.pages.item(0).textFrames.item(0);
  frame.fillColor = doc.swatches.itemByName('Black');
  frame.fillTint = 37;
  script.setResult(JSON.stringify({ ok: true, documentId: Number(doc.id) }));
} catch (error) {
  script.setResult(JSON.stringify({ ok: false, message: String(error.message || error) }));
}
