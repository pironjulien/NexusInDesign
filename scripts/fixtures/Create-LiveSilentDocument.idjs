const indesign = require('indesign');
const { app } = indesign;
const { script } = require('uxp');

try {
  const doc = app.documents.add();
  doc.viewPreferences.horizontalMeasurementUnits = indesign.MeasurementUnits.MILLIMETERS;
  doc.viewPreferences.verticalMeasurementUnits = indesign.MeasurementUnits.MILLIMETERS;
  doc.documentPreferences.pageWidth = 148;
  doc.documentPreferences.pageHeight = 210;
  doc.documentPreferences.facingPages = true;
  doc.pages.add();
  doc.insertLabel('fr.pironjulien.indesign.mcp.revision', '0');
  doc.insertLabel('fr.pironjulien.indesign.mcp.live-test', 'owned');
  script.setResult(JSON.stringify({ ok: true, documentId: Number(doc.id), pages: doc.pages.length }));
} catch (error) {
  script.setResult(JSON.stringify({ ok: false, message: String(error.message || error) }));
}
