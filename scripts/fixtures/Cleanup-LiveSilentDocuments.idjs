const { app, SaveOptions } = require('indesign');
const { script } = require('uxp');

const ownershipLabel = 'fr.pironjulien.indesign.mcp.live-test';
const ownershipValue = 'owned';
const documentsToClose = [];
let preserved = 0;

for (let index = 0; index < app.documents.length; index += 1) {
  const document = app.documents.item(index);
  if (document.extractLabel(ownershipLabel) === ownershipValue) documentsToClose.push(document);
  else preserved += 1;
}

for (let index = documentsToClose.length - 1; index >= 0; index -= 1) {
  // Ne pas employer de global await ici : DoScript doit récupérer le résultat
  // immédiatement. La boucle de contrôle du test confirme ensuite la fermeture.
  void documentsToClose[index].close(SaveOptions.no);
}

script.setResult(JSON.stringify({ ok: true, scheduled: documentsToClose.length, preserved }));
