{
  "name": "nexus-indesign",
  "version": "3.2.2",
  "description": "Passerelle MCP privée et authentifiée donnant à Claude et Codex un accès complet à Adobe InDesign UXP",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:live": "node scripts/Test-LiveInDesign.mjs",
    "test:live:smoke": "node scripts/Test-LiveInDesign.mjs --smoke",
    "test:live:connection": "node scripts/Test-LiveInDesign.mjs --connection-only",
    "test:live:pair": "node scripts/Test-LiveInDesign.mjs --connection-only --pair",
    "test:live:silent": "node scripts/Test-LiveSilentInDesign.mjs",
    "test:live:targeting": "node scripts/Diagnose-LiveTargeting.mjs",
    "package:stage": "node scripts/Prepare-UxpPackage.mjs",
    "package:ccx": "pwsh -NoProfile -File scripts/Build-UxpCcx.ps1",
    "release:verify": "pwsh -NoProfile -File scripts/Get-VerifiedCcx.ps1",
    "release:publish": "pwsh -NoProfile -File scripts/Publish-GitHubRelease.ps1",
    "install:workstation": "pwsh -NoProfile -File scripts/Install-Workstation.ps1",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 tests/*.test.js",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "indesign",
    "adobe",
    "automation",
    "publishing",
    "desktop-publishing",
    "codex",
    "ai",
    "llm",
    "design-automation",
    "document-creation",
    "layout-automation"
  ],
  "author": "Julien Piron",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "body-parser": "2.4.0",
    "fast-uri": "4.2.3",
    "hono": "4.13.13"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pironjulien/NexusInDesign.git"
  },
  "bugs": {
    "url": "https://github.com/pironjulien/NexusInDesign/issues"
  },
  "homepage": "https://github.com/pironjulien/NexusInDesign#readme",
  "private": true
}
