<Project Sdk="Microsoft.NET.Sdk">
  <!-- Installed as ~\.nexus\nexus-indesign\NexusInDesign.exe, the path the plugins start: it runs the engine of the
       version named by current.txt, from its own folder under versions\, which is never modified once written.
       Compiled ahead of time (Native AOT): a native program does not read its own file again after it starts, so an
       update can rename it aside while a session still runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>4.2.3</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NexusInDesignLauncher</AssemblyName>
    <RootNamespace>NexusInDesign.Launcher</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Both release architectures in the restore graph, so packages.lock.json covers the release publishes. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- The two packages below are pinned on purpose (see there): their "delete explicit reference" notice is answered. -->
    <SuppressGenerateILCompilerExplicitPackageReferenceWarning>true</SuppressGenerateILCompilerExplicitPackageReferenceWarning>
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
  </PropertyGroup>
  <ItemGroup>
    <!-- The AOT compiler and the trimmer, pinned like any package (packages.lock.json, Dependabot): left implicit, their
         version would follow the .NET SDK of the machine and break the locked restore whenever the CI's SDK moves. -->
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.14" />
  </ItemGroup>
</Project>
